# =======================================================
# TOKENLY POS — ENVIRONMENT CONFIGURATION & SMS GATEWAYS
# =======================================================

# Secret Key & DB
SECRET_KEY=tokenly-super-secret-key-2026-production-secure
DATABASE_URL=sqlite:///tokenly.db

# Target UPI Payment Parameters (₹1,999 / year)
UPI_VPA=9053088708@ptyes
UPI_PAYEE_NAME=TOKENLY

# -------------------------------------------------------
# SMS GATEWAY API KEYS (Configure AT LEAST ONE Provider)
# -------------------------------------------------------

# Option 1: Fast2SMS (Popular Indian OTP Gateway - Quick OTP Route)
# Get free API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Option 2: 2Factor.in (Popular Indian OTP API)
# Get API key from https://2factor.in/
TWO_FACTOR_API_KEY=

# Option 3: Twilio SMS (Global Gateway)
# Get credentials from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 4: MSG91 (Indian DLT Gateway)
# Get credentials from https://msg91.com/
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
